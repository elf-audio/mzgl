<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PARTIAL plist: the identity keys (CFBundleIdentifier/Executable/Version/
	     PackageType) are synthesised by Xcode via GENERATE_INFOPLIST_FILE, see
	     mzgl_add_auv3_plugin in cmake/plugin/mzgl-plugin.cmake. -->
	<key>CFBundleShortVersionString</key>
	<string>@AUV3_VERSION@</string>
	<key>CFBundleDisplayName</key>
	<string>@AUV3_PRODUCT_NAME@</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>@AUV3_COPYRIGHT@</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>AudioComponents</key>
			<array>
				<dict>
					<key>description</key>
					<string>@AUV3_DESCRIPTION@</string>
					<key>factoryFunction</key>
					<string>@AUV3_PRINCIPAL_CLASS@</string>
					<key>manufacturer</key>
					<string>@AUV3_MANUFACTURER@</string>
					<key>name</key>
					<string>@AUV3_NAME@</string>
					<key>sandboxSafe</key>
					<true/>
					<key>subtype</key>
					<string>@AUV3_SUBTYPE@</string>
					<key>tags</key>
					<array>
@AUV3_TAGS_XML@					</array>
					<key>type</key>
					<string>@AUV3_TYPE@</string>
					<key>version</key>
					<integer>@AUV3_VERSION_INT@</integer>
				</dict>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.AudioUnit-UI</string>
		<key>NSExtensionPrincipalClass</key>
		<string>@AUV3_PRINCIPAL_CLASS@</string>
	</dict>
</dict>
</plist>
